@model IEnumerable<ServiceRequest>
@{ ViewData["Title"] = "Service Requests"; }
<div class="page-heading"><div><p class="eyebrow">CAMPUS SUPPORT</p><h1>Service Requests</h1><p>Track and manage issues reported by students.</p></div><a class="btn btn-primary" asp-action="Create">+ New Request</a></div>
<form method="get" class="filter-bar"><input name="search" value="@ViewBag.Search" placeholder="Search student, issue or department" /><select name="status"><option value="">All statuses</option><option value="Pending" selected="@((ViewBag.Status as string) == "Pending" ? "selected" : null)">Pending</option><option value="In Progress" selected="@((ViewBag.Status as string) == "In Progress" ? "selected" : null)">In Progress</option><option value="Resolved" selected="@((ViewBag.Status as string) == "Resolved" ? "selected" : null)">Resolved</option></select><button class="btn btn-dark" type="submit">Filter</button><a class="btn btn-muted" asp-action="Index">Clear</a></form>
<div class="panel"><div class="table-wrap"><table><thead><tr><th>#</th><th>Student</th><th>Department</th><th>Issue</th><th>Status</th><th>Date</th><th>Actions</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Id</td><td><strong>@item.StudentName</strong></td><td>@item.Department</td><td>@item.Issue</td><td><span class="status @item.Status.Replace(" ", "").ToLowerInvariant()">@item.Status</span></td><td>@item.CreatedAt.ToString("dd MMM yyyy")</td><td class="actions"><a asp-action="Details" asp-route-id="@item.Id">View</a><a asp-action="Edit" asp-route-id="@item.Id">Edit</a><a class="danger-link" asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr> }
</tbody></table></div>@if (!Model.Any()) { <p class="empty">No service requests match your search.</p> }</div>
