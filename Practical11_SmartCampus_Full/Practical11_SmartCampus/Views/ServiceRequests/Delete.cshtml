@model ServiceRequest
@{ ViewData["Title"] = "Delete Request"; }
<div class="panel form-panel"><p class="eyebrow">CONFIRM ACTION</p><h1>Delete this request?</h1><p>Request #@Model.Id for <strong>@Model.StudentName</strong> — @Model.Issue</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><div class="form-actions"><a class="btn btn-muted" asp-action="Index">Cancel</a><button class="btn btn-danger" type="submit">Delete Request</button></div></form></div>
