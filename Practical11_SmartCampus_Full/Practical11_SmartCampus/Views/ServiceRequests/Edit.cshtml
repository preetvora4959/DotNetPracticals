@model ServiceRequest
@{ ViewData["Title"] = "Edit Service Request"; }
<div class="page-heading"><div><p class="eyebrow">CAMPUS SUPPORT</p><h1>Update Request #@Model.Id</h1><p>Update the request details or change its status.</p></div></div>
<div class="panel form-panel"><form asp-action="Edit" asp-route-id="@Model.Id" method="post"><input type="hidden" asp-for="Id" /><input type="hidden" asp-for="CreatedAt" /><partial name="_Form" model="Model" /><div class="form-actions"><a class="btn btn-muted" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit">Save Changes</button></div></form></div>
