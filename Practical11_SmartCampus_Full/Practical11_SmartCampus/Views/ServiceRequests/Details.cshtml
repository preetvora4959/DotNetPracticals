@model ServiceRequest
@{ ViewData["Title"] = "Request Details"; }
<div class="page-heading"><div><p class="eyebrow">REQUEST DETAILS</p><h1>Service Request #@Model.Id</h1></div><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit Request</a></div>
<div class="panel details-panel"><div class="detail-row"><span>Student Name</span><strong>@Model.StudentName</strong></div><div class="detail-row"><span>Department</span><strong>@Model.Department</strong></div><div class="detail-row"><span>Issue</span><strong>@Model.Issue</strong></div><div class="detail-row"><span>Description</span><strong>@Model.Description</strong></div><div class="detail-row"><span>Status</span><span class="status @Model.Status.Replace(" ", "").ToLowerInvariant()">@Model.Status</span></div><div class="detail-row"><span>Created At</span><strong>@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</strong></div><a class="btn btn-muted" asp-action="Index">Back to Requests</a></div>
