<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Campus</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="nav-wrap">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">SC</span><span>Smart Campus</span></a>
            <nav>
                <a asp-controller="Home" asp-action="Index">Dashboard</a>
                <a asp-controller="ServiceRequests" asp-action="Index">Service Requests</a>
                <a asp-controller="CampusEvents" asp-action="Index">Campus Events</a>
                <a href="/api/CampusApi/requests" target="_blank">API</a>
            </nav>
        </div>
    </header>
    <main class="page-shell">
        @if (TempData["Success"] != null)
        {
            <div class="alert-success">@TempData["Success"]</div>
        }
        @RenderBody()
    </main>
    <footer class="footer">Smart Campus Service Portal <span>·</span> ASP.NET Core MVC + SQLite + REST API</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
