@model IEnumerable<Practical6_ProductCatalog.Models.Product>

@{
    ViewBag.Title = "Product Catalog";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>TechZone Product Catalog</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            color: #202124;
        }

        .header {
            background: #263238;
            color: white;
            padding: 35px;
            text-align: center;
        }

            .header h1 {
                margin: 0 0 10px;
                font-size: 36px;
            }

            .header p {
                margin: 0;
                font-size: 16px;
            }

        .container {
            width: 90%;
            max-width: 1100px;
            margin: 35px auto;
        }

        .products {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
        }

        .card {
            background: white;
            padding: 22px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.1);
        }

            .card h3 {
                margin-top: 0;
                color: #263238;
            }

        .category {
            color: #607d8b;
            font-size: 14px;
        }

        .price {
            font-size: 21px;
            font-weight: bold;
            margin: 15px 0;
            color: #1565c0;
        }

        .button {
            display: inline-block;
            padding: 9px 15px;
            background: #1565c0;
            color: white;
            text-decoration: none;
            border-radius: 6px;
        }

            .button:hover {
                background: #0d47a1;
            }

        .footer {
            margin-top: 40px;
            padding: 18px;
            text-align: center;
            background: #263238;
            color: white;
        }
    </style>
</head>

<body>

    <div class="header">
        <h1>TechZone Product Catalog</h1>
        <p>Explore latest technology products and accessories</p>
    </div>

    <div class="container">

        <div class="products">

            @foreach (var product in Model)
            {
                <div class="card">

                    <h3>@product.Name</h3>

                    <div class="category">
                        Category: @product.Category
                    </div>

                    <div class="price">
                        ₹@product.Price
                    </div>

                    <a href="@Url.Action("Details", "Product", new { id = product.Id })"
                       class="button">
                        View Details
                    </a>

                </div>
            }

        </div>

    </div>

    <div class="footer">
        TechZone | ASP.NET MVC Product Catalog
    </div>

</body>
</html>