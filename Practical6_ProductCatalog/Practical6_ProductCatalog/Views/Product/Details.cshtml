@model Practical6_ProductCatalog.Models.Product

@{
    ViewBag.Title = "Product Details";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Product Details</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f7fb;
        }

        .header {
            background: #263238;
            color: white;
            text-align: center;
            padding: 30px;
        }

            .header h1 {
                margin: 0;
            }

        .details {
            width: 500px;
            margin: 55px auto;
            background: white;
            padding: 35px;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.12);
        }

            .details h2 {
                color: #1565c0;
                margin-top: 0;
            }

        .row {
            padding: 12px 0;
            border-bottom: 1px solid #eeeeee;
        }

        .label {
            font-weight: bold;
        }

        .price {
            font-size: 25px;
            font-weight: bold;
            color: #1565c0;
        }

        .button {
            display: inline-block;
            margin-top: 25px;
            padding: 10px 18px;
            background: #1565c0;
            color: white;
            text-decoration: none;
            border-radius: 6px;
        }

        .footer {
            text-align: center;
            background: #263238;
            color: white;
            padding: 18px;
            margin-top: 50px;
        }
    </style>
</head>

<body>

    <div class="header">
        <h1>TechZone Product Catalog</h1>
        <p>Product Information</p>
    </div>

    <div class="details">

        <h2>@Model.Name</h2>

        <div class="row">
            <span class="label">Product ID:</span>
            @Model.Id
        </div>

        <div class="row">
            <span class="label">Category:</span>
            @Model.Category
        </div>

        <div class="row">
            <span class="label">Price:</span>
            <span class="price">₹@Model.Price</span>
        </div>

        <div class="row">
            <span class="label">Description:</span>
            @Model.Description
        </div>

        <a href="@Url.Action("Index", "Product")" class="button">
            Back to Products
        </a>

    </div>

    <div class="footer">
        TechZone | ASP.NET MVC Application
    </div>

</body>
</html>