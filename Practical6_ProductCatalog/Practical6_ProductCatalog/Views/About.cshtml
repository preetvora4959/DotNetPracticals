@{
    ViewBag.Title = "About";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>About TechZone</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f7fb;
        }

        .container {
            width: 80%;
            max-width: 900px;
            margin: 60px auto;
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.1);
        }

        h1 {
            color: #1565c0;
            text-align: center;
        }

        p {
            color: #607d8b;
            line-height: 1.7;
            font-size: 16px;
        }

        .footer {
            margin-top: 40px;
            padding: 18px;
            text-align: center;
            background: #263238;
            color: white;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>About TechZone</h1>

        <p>
            TechZone is a simple product catalog application developed
            using ASP.NET MVC architecture.
        </p>

        <p>
            The application provides information about different technology
            products such as laptops, smartphones, audio devices and accessories.
        </p>

        <p>
            This project demonstrates the use of Models, Controllers, Views
            and Routing in ASP.NET MVC.
        </p>
    </div>

    <div class="footer">
        TechZone | ASP.NET MVC Product Catalog
    </div>

</body>
</html>