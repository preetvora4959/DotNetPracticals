@{
    Layout = null;
    ViewBag.Title = "About";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>About TechZone</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            color: #263238;
        }

        .header {
            background: #263238;
            color: white;
            padding: 35px;
            text-align: center;
        }

            .header h1 {
                margin: 0 0 10px;
                font-size: 36px;
            }

            .header p {
                margin: 0;
                font-size: 16px;
            }

        .container {
            width: 80%;
            max-width: 850px;
            margin: 50px auto;
            background: white;
            padding: 45px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.1);
        }

        h2 {
            color: #1565c0;
            text-align: center;
            font-size: 32px;
            margin-top: 0;
        }

        p {
            color: #607d8b;
            font-size: 17px;
            line-height: 1.7;
        }

        .section {
            margin-top: 25px;
        }

        .footer {
            margin-top: 50px;
            padding: 18px;
            text-align: center;
            background: #263238;
            color: white;
        }
    </style>
</head>

<body>

    <div class="header">
        <h1>TechZone</h1>
        <p>ASP.NET MVC Product Catalog</p>
    </div>

    <div class="container">

        <h2>About TechZone</h2>

        <div class="section">
            <p>
                TechZone is a simple product catalog application developed
                using ASP.NET MVC architecture.
            </p>

            <p>
                The application provides information about different
                technology products such as laptops, smartphones,
                audio devices and accessories.
            </p>

            <p>
                This project demonstrates the use of Models, Controllers,
                Views and Routing in ASP.NET MVC.
            </p>
        </div>

    </div>

    <div class="footer">
        TechZone | ASP.NET MVC Product Catalog
    </div>

</body>
</html>