@{
    Layout = null;
    ViewBag.Title = "Contact";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Contact TechZone</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            color: #263238;
        }

        .header {
            background: #263238;
            color: white;
            padding: 35px;
            text-align: center;
        }

            .header h1 {
                margin: 0 0 10px;
                font-size: 36px;
            }

            .header p {
                margin: 0;
                font-size: 16px;
            }

        .container {
            width: 80%;
            max-width: 700px;
            margin: 50px auto;
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.1);
        }

        h2 {
            color: #1565c0;
            text-align: center;
            font-size: 32px;
            margin-top: 0;
            margin-bottom: 30px;
        }

        .info {
            margin: 20px 0;
            padding: 18px;
            background: #f4f7fb;
            border-radius: 8px;
        }

            .info strong {
                color: #263238;
                font-size: 17px;
            }

            .info p {
                color: #607d8b;
                margin-bottom: 0;
                font-size: 16px;
            }

        .footer {
            margin-top: 50px;
            padding: 18px;
            text-align: center;
            background: #263238;
            color: white;
        }
    </style>
</head>

<body>

    <div class="header">
        <h1>TechZone</h1>
        <p>ASP.NET MVC Product Catalog</p>
    </div>

    <div class="container">

        <h2>Contact Us</h2>

        <div class="info">
            <strong>Address</strong>
            <p>Jamnagar, Gujarat</p>
        </div>

        <div class="info">
            <strong>Email</strong>
            <p>preetvora1011@gmail.com</p>
        </div>

        <div class="info">
            <strong>Phone</strong>
            <p>+91 98765 43210</p>
        </div>

    </div>

    <div class="footer">
        TechZone | ASP.NET MVC Product Catalog
    </div>

</body>
</html>