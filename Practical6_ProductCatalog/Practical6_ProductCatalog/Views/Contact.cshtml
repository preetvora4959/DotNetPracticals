@{
    ViewBag.Title = "Contact";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Contact TechZone</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f7fb;
        }

        .container {
            width: 80%;
            max-width: 700px;
            margin: 60px auto;
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.1);
        }

        h1 {
            color: #1565c0;
            text-align: center;
        }

        .info {
            margin: 20px 0;
            padding: 15px;
            background: #f4f7fb;
            border-radius: 8px;
        }

            .info strong {
                color: #263238;
            }

            .info p {
                color: #607d8b;
            }

        .footer {
            margin-top: 40px;
            padding: 18px;
            text-align: center;
            background: #263238;
            color: white;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Contact Us</h1>

        <div class="info">
            <strong>Address</strong>
            <p>Marwadi University, Rajkot, Gujarat</p>
        </div>

        <div class="info">
            <strong>Email</strong>
            <p>techzone@example.com</p>
        </div>

        <div class="info">
            <strong>Phone</strong>
            <p>+91 98765 43210</p>
        </div>
    </div>

    <div class="footer">
        TechZone | ASP.NET MVC Product Catalog
    </div>

</body>
</html>