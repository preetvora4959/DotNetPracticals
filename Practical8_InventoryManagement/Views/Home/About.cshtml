
@{
    ViewBag.Title = "About";
}

<div class="page-card">
    <h2>About Us</h2>

    <h3 style="color: #138577;">Inventory Management System</h3>

    <p style="font-size: 16px; line-height: 1.8;">
        The Inventory Management System is a web-based application
        developed to manage product records efficiently.
        It helps users maintain product details, stock quantities
        and prices in one place.
    </p>

    <h3 style="color: #138577;">Project Features</h3>

    <ul style="font-size: 16px; line-height: 2;">
        <li>Add new products to inventory.</li>
        <li>View all available product records.</li>
        <li>Update existing product information.</li>
        <li>Delete products when they are no longer required.</li>
        <li>Store and manage data using SQL Server.</li>
    </ul>

    <h3 style="color: #138577;">Technologies Used</h3>

    <p style="font-size: 16px; line-height: 1.8;">
        ASP.NET MVC, C#, ADO.NET, SQL Server, HTML and CSS.
    </p>

    <p style="font-size: 16px; line-height: 1.8;">
        This project demonstrates basic CRUD operations
        using ADO.NET for database connectivity and management.
    </p>
</div>
