
@model WebApplication1Practical8_InventoryManagement.Models.Product

@{
    ViewBag.Title = "Edit Product";
}

<div class="page-card">
    <h2>Edit Product</h2>
    <p style="color: #718198;">Update the product information below.</p>

    @using (Html.BeginForm())
    {
        @Html.HiddenFor(m => m.ProductId)

        <div class="form-group">
            <label>Product Name</label>
            @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control", placeholder = "Enter product name", required = "required" })
        </div>

        <div class="form-group">
            <label>Quantity</label>
            @Html.TextBoxFor(m => m.Quantity, new { @class = "form-control", type = "number", min = "0", required = "required" })
        </div>

        <div class="form-group">
            <label>Price (₹)</label>
            @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", min = "0", step = "0.01", required = "required" })
        </div>

        <br />

        <button type="submit" class="btn btn-success">Update Product</button>
        @Html.ActionLink("Back to Inventory", "Index", null, new { @class = "btn btn-default" })
    }
</div>
