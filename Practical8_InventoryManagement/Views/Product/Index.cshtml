
@model IEnumerable<WebApplication1Practical8_InventoryManagement.Models.Product>

@{
    ViewBag.Title = "Inventory Management";
}

<div class="page-card">
    <h2>Inventory Management</h2>
    <p style="color: #718198; margin-bottom: 25px;">
        Manage your products, stock and pricing efficiently.
    </p>

    <p>
        @Html.ActionLink("+ Add New Product", "Create", null, new { @class = "btn btn-primary" })
    </p>

    <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Product ID</th>
                    <th>Product Name</th>
                    <th>Quantity</th>
                    <th>Price (₹)</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProductId</td>
                        <td>@item.ProductName</td>
                        <td>@item.Quantity</td>
                        <td>@item.Price.ToString("0.00")</td>
                        <td>
                            @Html.ActionLink("Edit", "Edit", new { id = item.ProductId }, new { @class = "btn btn-primary btn-sm" })

                            @using (Html.BeginForm("Delete", "Product", new { id = item.ProductId }, FormMethod.Post, new { @class = "action-form" }))
                            {
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this product?')">
                                    Delete
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
